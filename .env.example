# Google OAuth2 Configuration
# Copia questo file in .env e inserisci le tue credenziali reali

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Google Search Console API
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# Scopes necessari
GOOGLE_SCOPES=https://www.googleapis.com/auth/webmasters.readonly,https://www.googleapis.com/auth/userinfo.email

# Environment
NODE_ENV=development

# Database SQLite locale (LibSQL)
# Default: ~/.seo-tool/data.db (auto-creato al primo avvio)
# Puoi usare un path relativo o assoluto con prefisso file:
DATABASE_URL="file:./dev.db"
