generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  tests     Test[]
}

model Test {
  id              String    @id @default(uuid())
  name            String
  urls            String[]
  siteUrl         String
  startDate       DateTime
  splitDate       DateTime
  status          String    @default("running")
  lastSyncAt      DateTime?
  lastPValue      Float?
  lastImprovement Float?
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  sharedWith      String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  metrics         Metric[]

  @@index([userId])
  @@index([status])
}

model Metric {
  id          Int       @id @default(autoincrement())
  testId      String
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  date        DateTime
  clicks      Int
  impressions Int
  gapFilled   Boolean   @default(false)
  filledAt    DateTime?
  createdAt   DateTime  @default(now())

  @@unique([testId, date])
  @@index([testId, date])
}

model AuditLog {
  id        String   @id @default(uuid())
  testId    String
  action    String
  userId    String
  timestamp DateTime @default(now())

  @@index([testId])
  @@index([userId])
}
