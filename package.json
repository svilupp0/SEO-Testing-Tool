{
  "name": "seo-testing-tool",
  "version": "1.0.0",
  "description": "SEO Testing Tool - Statistical analysis for SEO experiments",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "seo-tool": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "cli:run": "tsx src/cli.ts run",
    "smoke-test": "tsx src/smoke-test.ts"
  },
  "keywords": [
    "seo",
    "testing",
    "statistics",
    "google-search-console",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "prisma": "^7.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "asciichart": "^1.5.25",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^17.2.4",
    "pg": "^8.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
